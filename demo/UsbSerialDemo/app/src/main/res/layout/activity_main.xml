<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F2F5"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 标题 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="USB 串口通信 Demo"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#1976D2"
            android:gravity="center"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="通过USB连接MCU芯片，实现命令发送与接收"
            android:textSize="13sp"
            android:textColor="#666666"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <!-- 串口连接 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="串口连接"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:paddingBottom="8dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/section_divider" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- 第一排：连接/断开按钮 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <Button
                        android:id="@+id/btn_connect"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:text="连接串口"
                        android:textSize="14sp"
                        android:backgroundTint="#1976D2"
                        android:layout_marginEnd="8dp" />

                    <Button
                        android:id="@+id/btn_disconnect"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:text="断开连接"
                        android:textSize="14sp"
                        android:backgroundTint="#F44336" />
                </LinearLayout>

                <!-- 第二排：波特率和状态 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="波特率:"
                        android:textSize="13sp"
                        android:textColor="#666666"
                        android:layout_marginEnd="8dp" />

                    <Spinner
                        android:id="@+id/spinner_baud_rate"
                        android:layout_width="100dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="16dp" />

                    <View
                        android:id="@+id/status_dot"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:background="#CCCCCC"
                        android:layout_marginEnd="6dp" />

                    <TextView
                        android:id="@+id/tv_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="未连接"
                        android:textSize="14sp"
                        android:textColor="#666666" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- 灯光控制 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="灯光控制"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:paddingBottom="8dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/section_divider" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- 灯位置输入 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="灯位置:"
                        android:textSize="13sp"
                        android:textColor="#666666"
                        android:layout_marginEnd="8dp" />

                    <EditText
                        android:id="@+id/et_position"
                        android:layout_width="100dp"
                        android:layout_height="42dp"
                        android:inputType="number"
                        android:text="0"
                        android:gravity="center"
                        android:textSize="16sp"
                        android:background="@drawable/edit_text_bg" />
                </LinearLayout>

                <!-- 指定灯按钮 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <Button
                        android:id="@+id/btn_light_on"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:text="点亮指定灯"
                        android:textSize="14sp"
                        android:backgroundTint="#4CAF50"
                        android:layout_marginEnd="8dp"
                        android:enabled="false" />

                    <Button
                        android:id="@+id/btn_light_off"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:text="熄灭指定灯"
                        android:textSize="14sp"
                        android:backgroundTint="#F44336"
                        android:layout_marginStart="8dp"
                        android:enabled="false" />
                </LinearLayout>

                <!-- 全部灯按钮 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_light_all_on"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:text="点亮全部灯"
                        android:textSize="14sp"
                        android:backgroundTint="#FF9800"
                        android:layout_marginEnd="8dp"
                        android:enabled="false" />

                    <Button
                        android:id="@+id/btn_light_all_off"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:text="熄灭全部灯"
                        android:textSize="14sp"
                        android:backgroundTint="#9E9E9E"
                        android:layout_marginStart="8dp"
                        android:enabled="false" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- 通信日志 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="通信日志"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:paddingBottom="8dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/section_divider" />

            <ScrollView
                android:id="@+id/scroll_log"
                android:layout_width="match_parent"
                android:layout_height="250dp"
                android:background="#1E1E1E"
                android:padding="10dp">

                <TextView
                    android:id="@+id/tv_log"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="#9E9E9E"
                    android:fontFamily="monospace"
                    android:lineSpacingExtra="2dp" />
            </ScrollView>

            <Button
                android:id="@+id/btn_clear_log"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="清空日志"
                android:textSize="13sp"
                android:backgroundTint="#E0E0E0"
                android:textColor="#666666"
                android:layout_gravity="end"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- 协议说明 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="协议说明"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:paddingBottom="8dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/section_divider" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="帧格式: 0x55 + 0xAA + CMD + 数据长度 + 数据(uint16) + CRC-8/MAXIM\n\n命令字:\n  0x00 - 心跳  →  MCU响应 0x80\n  0x01 - 点亮灯  →  MCU响应 0x81\n  0x02 - 熄灭灯  →  MCU响应 0x82\n  0x03 - 全部灯  →  MCU响应 0x83\n\n数据: 0xFFFF=全部点亮, 0x0000=全部熄灭\nCRC: 多项式 x8+x5+x4+1, 初始值 0x00"
                android:textSize="12sp"
                android:textColor="#666666"
                android:lineSpacingExtra="2dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
